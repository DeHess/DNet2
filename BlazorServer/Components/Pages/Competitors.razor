@page "/competitors"
@inject HttpClient Http
@attribute [StreamRendering]

<PageTitle>Competitors</PageTitle>

<h1>Competitors</h1>

<p>This component demonstrates showing random competitors.</p>

@if (competitors == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var competitor in competitors)
            {
                <tr>
                    <td>@competitor.Name</td>
                    <td>@competitor.Time</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Competitor[]? competitors;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        competitors = await Http.GetFromJsonAsync<Competitor[]>("http://localhost:5001/data/competitors.json");
    }

    private class Competitor
    {
        public required string Name { get; set; }
        public required string Time { get; set; }
    }
}

